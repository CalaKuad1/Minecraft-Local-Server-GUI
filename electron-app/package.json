{
  "name": "minecraft-server-gui",
  "private": true,
  "version": "2.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/CalaKuad1/Minecraft-Local-Server-GUI.git"
  },
  "description": "Cubi: host a Minecraft server on your PC and play with your friends",
  "author": "CalaKuad <calakuad.dev@gmail.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:backend": "node scripts/build-backend.mjs",
    "electron:build": "npm run build:backend && vite build && electron-builder"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "clsx": "^2.1.0",
    "electron-updater": "^6.3.9",
    "framer-motion": "^10.16.0",
    "lucide-react": "1.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "skinview3d": "3.4.2",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.minecraft.localservergui",
    "productName": "Cubi",
    "publish": [
      {
        "provider": "github",
        "owner": "CalaKuad1",
        "repo": "Minecraft-Local-Server-GUI",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/venv/**",
          "!**/env/**",
          "!**/java_runtimes/**",
          "!**/build/**",
          "!**/dist/**"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/images/icon.ico",
      "artifactName": "Cubi-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/images/logo2.png",
      "category": "Game",
      "artifactName": "Cubi-${version}.${ext}",
      "synopsis": "Host a Minecraft server on your PC and play with friends",
      "desktop": {
        "Name": "Cubi",
        "Comment": "Host a Minecraft server on your PC and play with friends",
        "Keywords": "minecraft;server;"
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "public/images/icon.ico",
      "uninstallerIcon": "public/images/icon.ico",
      "runAfterFinish": true,
      "shortcutName": "Cubi",
      "uninstallDisplayName": "Cubi",
      "installerHeaderIcon": "public/images/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "copyright": "Copyright (c) CalaKuad1. MIT License.",
    "deb": {
      "artifactName": "cubi_${version}_${arch}.${ext}"
    }
  }
}
